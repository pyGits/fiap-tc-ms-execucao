# Execução Service — participante da Saga (fila e execução dos serviços)
PORT=3002
NODE_ENV=development
SERVICE_NAME=fiap-tc-ms-execucao
LOG_LEVEL=debug

# Banco próprio (MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fiap_tc_execucao
MONGO_TIMEOUT_MS=5000

# Mensageria
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10

# Capacidade da oficina: fila cheia é recusa legítima de negócio
CAPACIDADE_FILA=20

# Autenticação: true sobe sem Cognito (apenas desenvolvimento e testes)
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Observabilidade
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=fiap-tc-ms-execucao-local
